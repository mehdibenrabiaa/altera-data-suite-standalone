{
  "name": "altera-studio",
  "version": "1.0.0",
  "private": true,
  "main": "dist-electron/main.js",
  "author": "Altera",
  "description": "Altera Data Suite",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dist:win": "npm run build && electron-builder --win",
    "publish:update": "node scripts/publish-update.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@xyflow/react": "^12.11.2",
    "ag-grid-community": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "antd": "^6.2.0",
    "electron-updater": "^6.3.9",
    "konva": "^10.0.12",
    "pdfjs-dist": "^3.11.174",
    "rc-dock": "^3.3.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-konva": "^19.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.alteradatasuite.studio",
    "productName": "Altera Data Suite",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/favicon.ico"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!backend-restart.log"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://backend.alteradatasuite.com/updates"
    }
  }
}
